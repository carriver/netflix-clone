# Copy to .env.local and fill in. Values are embedded in the client bundle,
# so these are public identifiers, not secrets: protect data with Firestore
# security rules and restrict the TMDB key in the TMDB dashboard.

# Firebase console > Project settings > General > Your apps > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# https://www.themoviedb.org/settings/api (API Key, v3 auth)
VITE_TMDB_API_KEY=
